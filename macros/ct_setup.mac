# Geometry Setup
/control/verbose 1
/run/verbose 1
/tracking/verbose 0

/gate/world/geometry/setXLength 40. cm
/gate/world/geometry/setYLength 40. cm
/gate/world/geometry/setZLength 40. cm
/gate/world/setMaterial Air

# Phantom (Water box)
#/gate/world/daughters/name phantom
#/gate/world/daughters/insert box
#/gate/phantom/geometry/setXLength 10. cm
#/gate/phantom/geometry/setYLength 10. cm
#/gate/phantom/geometry/setZLength 1. cm
#/gate/phantom/setMaterial Water
#/gate/phantom/placement/setTranslation 0. 0. 0. cm

# Detector
/gate/world/daughters/name detector
/gate/world/daughters/insert box
/gate/detector/geometry/setXLength 20. cm
/gate/detector/geometry/setYLength 20. cm
/gate/detector/geometry/setZLength 1. cm
/gate/detector/setMaterial Air
/gate/detector/placement/setTranslation 0. 0. 20. cm

# Sensitive detector
/gate/detector/attachCrystalSD

# Source setup
/gate/source/addSource xray cone
/gate/source/xray/setActivity 1.0e6
/gate/source/xray/setParticleType gamma
/gate/source/xray/setEnergy 60 keV
/gate/source/xray/gps/position/type Point
/gate/source/xray/gps/position/centre 0. 0. -20. cm
/gate/source/xray/gps/ang/type iso

# Physics
/gate/physics/addPhysics standard
/gate/physics/addPhysics emstandard
/gate/physics/addPhysics decay

# Output
/gate/output/root/setFileName output
/gate/output/root/setRootFlag 1
/gate/output/root/setSaveHitsFlag 1
/gate/output/root/setSaveSinglesFlag 1
