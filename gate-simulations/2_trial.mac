/gate/geometry/setMaterialDatabase /home/gv/SagarED20/geant4/geant4-v11.3.0-install/share/Geant4/data/G4NDL4.7.1

# -------------------------------
# Simple GATE Macro (Test Version)
# -------------------------------

# 1. World Geometry
/gate/world/geometry/setXLength 1 m
/gate/world/geometry/setYLength 1 m
/gate/world/geometry/setZLength 1 m
/gate/world/setMaterial Air
/gate/geometry/rebuild

# 2. Physics List (for gamma interactions)
/gate/physics/addPhysicsList QGSP_BIC_EMY

# 3. Initialize FIRST!
/gate/run/initialize

# 4. Enable Verbose Output (shows progress)
/gate/application/verbose 1     # Level 1 = basic progress
# /gate/application/verbose 2   # Level 2 = per-event details

# 5. Source Configuration
/gate/source/addSource mySource gps
/gate/source/mySource/gps/particle gamma
/gate/source/mySource/gps/energy 511 keV
/gate/source/mySource/gps/type Point
/gate/source/mySource/gps/centre 0 0 0 cm
/gate/source/mySource/setActivity 1e3 Bq  # Reduced to 1,000 Bq

# 6. Dose Actor
/gate/actor/addActor DoseActor myDoseActor
/gate/actor/myDoseActor/attachTo world
/gate/actor/myDoseActor/save test_output.mhd

# 7. SHORT Simulation Time (0.1 seconds = ~100 events)
/gate/application/setTimeStart 0 s
/gate/application/setTimeStop 0.1 s
/gate/application/startDAQ
