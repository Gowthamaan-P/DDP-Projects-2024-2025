# ---------------------------------------
# 0. Material Database
# ---------------------------------------
/gate/geometry/setMaterialDatabase /home/gv/SagarED20/gate/gate-source/GateMaterials.db

# ---------------------------------------
# 1. World Geometry
# ---------------------------------------
/gate/world/geometry/setXLength 1 m
/gate/world/geometry/setYLength 1 m
/gate/world/geometry/setZLength 1 m
/gate/world/setMaterial Air
/gate/geometry/rebuild

# ---------------------------------------
# 2. Visualization
# ---------------------------------------
/vis/open OGL
/vis/drawVolume
/vis/viewer/set/viewpointThetaPhi 60 30
/vis/viewer/zoom 2
/vis/scene/add/trajectories smooth
/vis/scene/add/hits
/vis/viewer/set/autoRefresh 0
/vis/scene/endOfEventAction accumulate 10

# ---------------------------------------
# 3. Physics List
# ---------------------------------------
/gate/physics/addPhysicsList QGSP_BIC_EMY

# ---------------------------------------
# 4. Phantom (Water Cylinder)
/gate/world/daughters/name phantom
/gate/world/daughters/insert cylinder
/gate/phantom/setMaterial Water
/gate/phantom/geometry/setRmin 0 cm
/gate/phantom/geometry/setRmax 5 cm
/gate/phantom/geometry/setHeight 10 cm
/gate/phantom/placement/setTranslation 0 0 0 cm
/gate/phantom/vis/setColor blue

# ---------------------------------------
# 5. Detector (Flat Panel)
/gate/world/daughters/name detector
/gate/world/daughters/insert box
/gate/detector/setMaterial Silicon
/gate/detector/geometry/setXLength 10 cm
/gate/detector/geometry/setYLength 10 cm
/gate/detector/geometry/setZLength 1 mm
/gate/detector/placement/setTranslation 0 0 15 cm
/gate/detector/vis/setColor green

# Make detector sensitive
/gate/detector/setSensitiveDetector MySD

# Digitizer chain
/gate/digitizerMgr/MySD/SinglesDigitizer/Singles/insert adder
/gate/digitizerMgr/MySD/SinglesDigitizer/Singles/insert readout
/gate/output/root/enable
/gate/output/root/setFileName outputCT

# ---------------------------------------
# 6. Rotating Source Holder
/gate/world/daughters/name sourceHolder
/gate/world/daughters/insert cylinder
/gate/sourceHolder/setMaterial Air
/gate/sourceHolder/geometry/setRmin 0 cm
/gate/sourceHolder/geometry/setRmax 0.1 cm
/gate/sourceHolder/geometry/setHeight 0.1 cm
/gate/sourceHolder/placement/setTranslation 0 0 0 cm

# Add rotation motion to sourceHolder
/gate/sourceHolder/attachRotatingMotion sourceRotation
/gate/sourceHolder/sourceRotation/setSpeed 36 deg/s
/gate/sourceHolder/sourceRotation/setPoint 0 0 0 cm
/gate/sourceHolder/sourceRotation/setAxis 0 1 0

# ---------------------------------------
# 7. Source (Point Gamma at 100 keV)
/gate/source/addSource mySource gps
/gate/source/mySource/gps/particle gamma
/gate/source/mySource/gps/energy 100 keV
/gate/source/mySource/gps/type Point
/gate/source/mySource/gps/centre 0 0 -15 cm
/gate/source/mySource/setActivity 1e6 Bq
/gate/source/mySource/setPlacement sourceHolder

# ---------------------------------------
# 8. Initialize and Start Scan
/gate/run/initialize

/tracking/verbose 0

/gate/application/setTimeStart 0 s
/gate/application/setTimeStop 10 s
/gate/application/startDAQ
